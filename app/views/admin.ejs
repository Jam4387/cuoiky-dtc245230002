<!doctype html><html><head><meta charset="utf-8"><title>Admin</title><style>body{font-family:sans-serif;max-width:800px;margin:30px auto}input,textarea{width:100%;margin:4px 0}</style></head><body><h2>Quản lý nội dung</h2><a href="/">Xem website</a> | <a href="/admin/logout">Đăng xuất</a><h3>Thông tin cá nhân</h3><form method="post" action="/admin/profile">  <input name="full_name" value="<%= profile.full_name %>">  <input name="title" value="<%= profile.title %>">  <textarea name="bio"><%= profile.bio %></textarea>  <input name="email" value="<%= profile.email %>">  <button>Lưu</button></form><h3>Thêm dự án</h3><form method="post" action="/admin/projects">  <input name="title" placeholder="Tên dự án" required>  <textarea name="description" placeholder="Mô tả"></textarea>  <input name="link" placeholder="https://...">  <button>Thêm</button></form><h3>Danh sách dự án</h3><% projects.forEach(p => { %>  <div><b><%= p.title %></b>  <form method="post" action="/admin/projects/<%= p.id %>/delete" style="display:inline"><button>Xóa</button></form></div><% }) %></body></html>
