<!doctype html><html lang="vi"><head><meta charset="utf-8"><title><%= profile.full_name %> - Portfolio</title><style>body{font-family:sans-serif;max-width:800px;margin:40px auto;padding:0 16px}.card{border:1px solid #ddd;border-radius:8px;padding:12px;margin:10px 0}</style></head><body><h1><%= profile.full_name %></h1><h3><%= profile.title %></h3><p><%= profile.bio %></p><p>Email: <%= profile.email %></p><h2>Dự án</h2><% projects.forEach(p => { %>  <div class="card"><h4><%= p.title %></h4><p><%= p.description %></p>  <% if (p.link) { %><a href="<%= p.link %>">Xem dự án</a><% } %></div><% }) %><p><a href="/admin">Admin</a></p></body></html>
